<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- GLSurfaceView for OpenGL ES rendering -->
    <android.opengl.GLSurfaceView
        android:id="@+id/gl_surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Debug Button Overlay - Top-left, below status bar -->
    <LinearLayout
        android:id="@+id/debug_button_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="50dp"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_debug_console"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Console"
            android:textSize="12sp"
            android:padding="4dp" />

        <Button
            android:id="@+id/btn_debug_npc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NPC"
            android:textSize="12sp"
            android:padding="4dp" />

        <Button
            android:id="@+id/btn_debug_world"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="World"
            android:textSize="12sp"
            android:padding="4dp" />

        <Button
            android:id="@+id/btn_debug_perf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Perf"
            android:textSize="12sp"
            android:padding="4dp" />

        <Button
            android:id="@+id/btn_debug_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All"
            android:textSize="12sp"
            android:padding="4dp" />

        <Button
            android:id="@+id/btn_debug_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textSize="12sp"
            android:padding="4dp" />

    </LinearLayout>

    <!-- Debug Toggle Button - Top-left corner, above panel -->
    <Button
        android:id="@+id/btn_debug_toggle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:text="D"
        android:textSize="12sp"
        android:background="#333333"
        android:textColor="#FFFFFF"
        android:alpha="0.5"
        android:elevation="10dp" />

</FrameLayout>
